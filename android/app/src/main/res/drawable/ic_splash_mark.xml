<?xml version="1.0" encoding="utf-8"?>
<!-- Launch mark: the full-colour logo on its dark plate, drawn at 33 % of the shortest side
     (the platform's standard splash proportion) so the hand-off to Compose is seamless. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#050709" />
        </shape>
    </item>
    <item
        android:width="88dp"
        android:height="88dp"
        android:gravity="center"
        android:drawable="@drawable/logo_brand" />
</layer-list>
