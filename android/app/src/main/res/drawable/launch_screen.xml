<?xml version="1.0" encoding="utf-8"?>
<!--
  Branded launch window: the app's night background with the logo mark centred at 33 % of the
  shortest side, so the first frame of Compose lands on the same visual as the splash.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="132dp"
        android:height="132dp"
        android:gravity="center"
        android:drawable="@drawable/ic_splash_mark" />
</layer-list>
