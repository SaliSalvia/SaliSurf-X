# SaliSurf-X API — container image
# Works on RunFlare (Docker hosting), Hugging Face Spaces (set PORT=7860),
# Fly.io/Koyeb-style platforms, or any plain Docker host.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

WORKDIR /app

# Runtime and build dependencies are fully pinned (versions + SHA-256 hashes)
# in requirements.lock / requirements-build.lock, generated by uv for Python 3.10+.
COPY pyproject.toml README.md requirements.lock requirements-build.lock ./
COPY subsurface_api ./subsurface_api
# Build with the pinned setuptools instead of resolving the build backend at
# build time; the fixed SOURCE_DATE_EPOCH makes the resulting wheel reproducible.
RUN pip install --no-cache-dir -r requirements.lock \
    && pip install --no-cache-dir -r requirements-build.lock \
    && SOURCE_DATE_EPOCH=1794182400 pip install --no-cache-dir \
        --no-build-isolation --no-deps .

# Run as an unprivileged user; the artifact volume defaults to /app/deep_jobs.
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home app \
    && mkdir -p /app/deep_jobs \
    && chown -R app:app /app
USER app

EXPOSE 8000

# Readiness (not just liveness): the API must also be able to write artifacts.
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/api/v1/ready' % os.environ.get('PORT', '8000'), timeout=5)"

# $PORT is honoured so platform-managed ports work (RunFlare, HF Spaces, etc.).
CMD ["sh", "-c", "uvicorn subsurface_api.main:app --host 0.0.0.0 --port ${PORT}"]
